# Z.ai GLM credentials — copy to trainer/.env and fill in. Never commit .env.
GLM_API_KEY=
# Coding-plan keys must use the coding endpoint; pay-as-you-go keys use
# https://api.z.ai/api/paas/v4 instead.
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Model split (benchmarked 2026-07-30):
# - Tutor (interactive): thinking OFF for ~1s first token instead of ~2.5s.
# - Heavy (classifier/cards, background): thinking ON, quality over speed.
GLM_MODEL=glm-5.2
GLM_TUTOR_MODEL=glm-5.2
GLM_TUTOR_THINKING=off
GLM_HEAVY_MODEL=glm-5.2

# Telegram bot (optional). Create one with @BotFather, paste the token.
# After first /start, the bot replies with your chat id — set it here to
# lock the bot to you (strongly recommended).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: public HTTPS URL of this server (e.g. a Cloudflare tunnel).
# When set, the bot's menu button opens the full web app as a Telegram
# Mini App.
# TRAINER_PUBLIC_URL=

# Web app (optional overrides)
# TRAINER_PORT=8787
# TRAINER_KEY=
# TRAINER_CASES_PER_SESSION=4
# ANKI_CONNECT_URL=http://127.0.0.1:8765
# ANKI_DECK=Clinical Reasoning
